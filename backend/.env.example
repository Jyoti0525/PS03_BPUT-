# Copy to .env for local runs. All settings use the JEEVIA_ prefix (see app/config.py).
JEEVIA_DATABASE_URL=sqlite:///./data/jeevia.db
# JEEVIA_DATABASE_URL=postgresql+psycopg://jeevia:jeevia@localhost:5432/jeevia
JEEVIA_JWT_SECRET=replace-with-a-long-random-string
JEEVIA_OTP_PROVIDER=mock
JEEVIA_DEMO_OTP=123456
JEEVIA_CORS_ORIGINS=http://localhost:3000
JEEVIA_SEED_DEMO=true
JEEVIA_REQUIRE_BOUND_DEVICE=true
