# Copy to .env for local runs. All settings use the JEEVIA_ prefix (see app/config.py).
JEEVIA_DATABASE_URL=sqlite:///./data/jeevia.db
# What runs here: stub (rules only, no models: CI and the cloud demo) | demo (models load on first use) | full (preloaded)
JEEVIA_PROFILE=demo
# JEEVIA_DATA_ORIGIN=SYNTHETIC
# Summary model: llama.cpp llama-server on this laptop, e.g.
#   llama-server -m models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf --port 8031 -ngl 99 --temp 0
# JEEVIA_LLM_URL=http://127.0.0.1:8031
# JEEVIA_DATABASE_URL=postgresql+psycopg://jeevia:jeevia@localhost:5432/jeevia
JEEVIA_JWT_SECRET=replace-with-a-long-random-string
JEEVIA_OTP_PROVIDER=mock
JEEVIA_DEMO_OTP=123456
JEEVIA_CORS_ORIGINS=http://localhost:3000
JEEVIA_SEED_DEMO=true
JEEVIA_REQUIRE_BOUND_DEVICE=true

# Sarvam AI (online voice for reminder-call lines, second speech engine). Unset = the device's own voice.
# SARVAM_API_KEY=
# Real reminder calls and SMS through Twilio or Vonage (app/telephony.py, app/vonage.py). Every call and SMS goes to the one demo phone,
# never to a patient's stored number. Unset = nothing is dialled or sent.
# JEEVIA_TWILIO_ACCOUNT_SID=
# JEEVIA_TWILIO_AUTH_TOKEN=
# JEEVIA_TWILIO_FROM_NUMBER=+1...
# Or Vonage (used instead of Twilio when its key is set). The private key is the Vonage application's; *.key is gitignored.
# JEEVIA_VONAGE_API_KEY=
# JEEVIA_VONAGE_API_SECRET=
# JEEVIA_VONAGE_APPLICATION_ID=
# JEEVIA_VONAGE_PRIVATE_KEY_PATH=vonage_private.key
# JEEVIA_TELEPHONY_DEMO_TO=+91...
# JEEVIA_PUBLIC_BASE_URL=https://....trycloudflare.com
